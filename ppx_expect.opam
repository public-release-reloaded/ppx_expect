opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_expect"
bug-reports: "https://github.com/public-release-reloaded/ppx_expect/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_expect.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_expect/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "capsule" {>= "v0.18~" & < "v0.19~"}
  "portable" {>= "v0.18~" & < "v0.19~"}
  "ppx_fuelproof" {>= "v0.18~" & < "v0.19~"}
  "ppx_here" {>= "v0.18~" & < "v0.19~"}
  "ppx_inline_test" {>= "v0.18~" & < "v0.19~"}
  "stdio" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ppxlib" {>= "0.38.0"}
]
available: arch != "x86_32"
synopsis: "Cram like framework for OCaml"
description: "
Part of the Jane Street's PPX rewriters collection.
"
